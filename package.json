{
  "name": "muscle-tracker-backend",
  "version": "1.0.0",
  "description": "Backend API for Muscle Tracker",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f",
    "typeorm": "tsx ./node_modules/typeorm/cli.js",
    "schema:log": "tsx ./node_modules/typeorm/cli.js schema:log -d src/config/database.ts",
    "schema:sync": "tsx ./node_modules/typeorm/cli.js schema:sync -d src/config/database.ts",
    "migration:generate": "tsx ./node_modules/typeorm/cli.js migration:generate -d src/config/database.ts",
    "migration:run": "tsx ./node_modules/typeorm/cli.js migration:run -d src/config/database.ts",
    "migration:revert": "tsx ./node_modules/typeorm/cli.js migration:revert -d src/config/database.ts"
  },
  "keywords": [
    "muscle-tracker",
    "api",
    "express",
    "typescript",
    "mysql"
  ],
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mysql2": "^3.12.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.9",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
